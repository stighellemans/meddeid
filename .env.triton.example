# Copy to .env.triton, replace the example secret, choose one workload profile,
# and keep that file private.
MEDDEID_TRITON_IMAGE=ghcr.io/stighellemans/meddeid-triton-t4-sm75:0.3.0-trt26.07-fp16
MEDDEID_API_IMAGE=ghcr.io/stighellemans/meddeid-triton-gateway:0.3.0
MEDDEID_API_KEY=replace-with-at-least-32-random-bytes
MEDDEID_SERVING_PROFILE=latency
MEDDEID_BIND_ADDRESS=127.0.0.1
MEDDEID_PORT=8000

# Optional only when the service should use a GPU other than device 0:
# MEDDEID_GPU_DEVICE_ID=1
# The gateway image already contains the measured binary transport, four
# weight-free workers, request-local batch size, and admission defaults.
