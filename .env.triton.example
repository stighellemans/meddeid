# Copy this file to .env.triton and keep that copy private.
# All other settings: https://github.com/stighellemans/meddeid/blob/main/docs/production.md#environment-variable-reference

# Model, revision, and language profile matched to the compiled plan.
MEDDEID_MODEL=stighellemans/meddeid-dutch-synth
MEDDEID_REVISION=1f20655454dcbd042647cacdfff6b6802a970959
MEDDEID_LANGUAGE_PROFILE=nl-BE

# API authentication. Replace the example secret and keep it private.
MEDDEID_API_KEY=replace-with-at-least-32-random-bytes
MEDDEID_REQUIRE_API_KEY=true

# Host address and port. Keep localhost when a proxy runs on this host.
MEDDEID_BIND_ADDRESS=127.0.0.1
MEDDEID_PORT=8000

# latency suits individual requests; throughput keeps the release scheduler.
MEDDEID_SERVING_PROFILE=latency

# Optional browser UI and interactive API documentation.
MEDDEID_DOCS_ENABLED=false
MEDDEID_UI_ENABLED=false
