# Copy to .env.cuda, inject the API key from a secret manager, choose one
# workload profile, and pin the validated image by digest in production.
MEDDEID_PYTORCH_CUDA_IMAGE=ghcr.io/stighellemans/meddeid-api:0.3.0-cuda12.9
MEDDEID_API_KEY=replace-with-at-least-32-random-bytes
MEDDEID_SERVING_PROFILE=latency
MEDDEID_BIND_ADDRESS=127.0.0.1
MEDDEID_PORT=8000

# Optional only when the service should use a GPU other than device 0:
# MEDDEID_GPU_DEVICE_ID=1
# Advanced source-build and scheduler controls are documented separately;
# the published image already contains the benchmarked defaults.
