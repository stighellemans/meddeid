# Published CPU API image. Replace the tag with the digest you validated before
# production use.
MEDDEID_API_IMAGE=ghcr.io/stighellemans/meddeid-api:0.3.0

# The published image contains its model and runs offline. Keep these values for
# the standard CPU deployment. Leave the profile empty to use the bundle default.
MEDDEID_MODEL=/opt/meddeid-model
MEDDEID_REVISION=
MEDDEID_OFFLINE=true
MEDDEID_LANGUAGE_PROFILE=

# The default host bind address is localhost. Change it only when an
# authenticated reverse proxy or private network is in front of MedDeID.
MEDDEID_BIND_ADDRESS=127.0.0.1
MEDDEID_PORT=8000

# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDDEID_API_KEY=
MEDDEID_REQUIRE_API_KEY=false

# Optional serving-only policy. Values are comma-separated. MEDDEID_ALLOWED_MODELS
# contains exact accepted MEDDEID_MODEL values; profiles limit request selection.
MEDDEID_ALLOWED_MODELS=
MEDDEID_ALLOWED_LANGUAGE_PROFILES=

# API documentation is useful during restricted integration testing. Keep it
# disabled for an unattended service unless the proxy limits it to operators.
MEDDEID_DOCS_ENABLED=false
MEDDEID_UI_ENABLED=false

# Request logging and reverse-proxy handling. Enable proxy headers only for a
# trusted proxy and replace the allowlist with its exact IP address.
MEDDEID_ACCESS_LOG=true
MEDDEID_PROXY_HEADERS=false
MEDDEID_FORWARDED_ALLOW_IPS=127.0.0.1

# CPU defaults. Increase only after measuring the target workload.
MEDDEID_BACKEND=torch
MEDDEID_DEVICE=cpu
MEDDEID_WINDOW_BATCH_SIZE=32
MEDDEID_WORKERS=1
MEDDEID_MAX_CONCURRENT_REQUESTS=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Request safety limits.
MEDDEID_MAX_INPUT_CHARS=20000
MEDDEID_MAX_BATCH_DOCUMENTS=32
MEDDEID_MAX_BATCH_CHARS=200000
MEDDEID_MAX_REQUEST_BYTES=2000000
MEDDEID_QUEUE_TIMEOUT_SECONDS=30

# Warn when a requested nonzero date shift is smaller than this many days.
MEDDEID_MIN_RECOMMENDED_DATE_SHIFT_DAYS=366

# Local image builds only. These pins are ignored when Compose pulls the image
# above. Change them together only when building and validating a new image.
MEDDEID_CORE_COMMIT=13cd703eba34d92b128f54813741ac956258c213
MEDDEID_LANGUAGE_EN_COMMIT=cf624a922c83bcd0a53bc7ca284d191ded226282
MEDDEID_LANGUAGE_NL_COMMIT=7fad096fd40c138036db0835d4de4ffd5513ae1a
MEDDEID_MODEL_ID=stighellemans/meddeid-dutch-synth
MEDDEID_MODEL_REVISION=1f20655454dcbd042647cacdfff6b6802a970959
