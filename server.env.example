# Copy to meddeid-server.env, restrict its permissions, and edit the values.
# Start with: meddeid-server --env-file meddeid-server.env

# Model and locale policy. An empty revision means the latest Hub revision.
MEDDEID_MODEL=stighellemans/meddeid-dutch-synth
MEDDEID_REVISION=
MEDDEID_OFFLINE=false
MEDDEID_LANGUAGE_PROFILE=nl-BE
MEDDEID_ALLOWED_MODELS=stighellemans/meddeid-dutch-synth
MEDDEID_ALLOWED_LANGUAGE_PROFILES=nl-BE

# Inference backend.
MEDDEID_BACKEND=torch
MEDDEID_DEVICE=cpu
MEDDEID_TORCH_PRECISION=fp32
MEDDEID_TORCH_COMPILE_MODE=off
MEDDEID_TORCH_COMPILE_DYNAMIC=true
MEDDEID_WINDOW_BATCH_SIZE=32
# Use latency for on-demand calls or throughput for cross-request CUDA/MPS
# microbatching. The remaining microbatch values are advanced overrides.
MEDDEID_SERVING_PROFILE=latency
MEDDEID_MICROBATCH_ENABLED=auto
MEDDEID_MICROBATCH_MAX_WINDOWS=32
MEDDEID_MICROBATCH_MAX_TOKENS=16384
MEDDEID_MICROBATCH_MAX_WAIT_MS=1
MEDDEID_MICROBATCH_QUEUE_MAX_WINDOWS=8192
MEDDEID_MICROBATCH_QUEUE_MAX_REQUESTS=256
MEDDEID_SEQUENCE_LENGTH_BUCKETS=auto
MEDDEID_TRITON_URL=
MEDDEID_TRITON_TIMEOUT=30
MEDDEID_TRITON_TRANSPORT=json

# Authentication. Keep REQUIRE_API_KEY=true; inject or set a random secret.
MEDDEID_API_KEY=
MEDDEID_REQUIRE_API_KEY=true

# Network and HTTP surface.
MEDDEID_BIND_ADDRESS=127.0.0.1
MEDDEID_PORT=8000
# Enable docs for restricted integration testing; otherwise limit the routes at
# the reverse proxy or keep them disabled in an unattended deployment.
MEDDEID_DOCS_ENABLED=false
MEDDEID_UI_ENABLED=false
MEDDEID_ACCESS_LOG=true
MEDDEID_PROXY_HEADERS=false
MEDDEID_FORWARDED_ALLOW_IPS=127.0.0.1

# Workload limits.
MEDDEID_WORKERS=1
# auto selects 1 for latency, 16 for accelerated Torch throughput, or 8 per Triton
# gateway worker. Set an integer only after workload-specific measurement.
MEDDEID_MAX_CONCURRENT_REQUESTS=auto
MEDDEID_QUEUE_TIMEOUT_SECONDS=30
MEDDEID_MAX_INPUT_CHARS=20000
MEDDEID_MAX_BATCH_DOCUMENTS=32
MEDDEID_MAX_BATCH_CHARS=200000
MEDDEID_MAX_REQUEST_BYTES=2000000
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Optional policy overrides.
MEDDEID_AGE_GRANULARITY_CONFIG=
MEDDEID_MIN_RECOMMENDED_DATE_SHIFT_DAYS=366
