# Immutable inputs for the first supported MedDeID TensorRT/Triton stack.
# Update all related fields together and rerun the GPU release gate.
MEDDEID_TRITON_STACK=26.07
MEDDEID_TRITON_SERVER_VERSION=2.71.0
MEDDEID_TENSORRT_VERSION=11.1.0.106
MEDDEID_TRITON_BASE_IMAGE=nvcr.io/nvidia/tritonserver:26.07-py3@sha256:f76300c73eba7dd4c67183210c10b3fef67fb9aa2c18f150cb916387078442f0
MEDDEID_TRITON_MIN_IMAGE=nvcr.io/nvidia/tritonserver:26.07-py3-min@sha256:091778e7ad4a9fe980c28ee121219bf9cacf5d6ef1ade65ba76770bfd6a35a16
MEDDEID_TRITON_COMPOSE_REVISION=819ee37770df2fcd6d799d2a5d1dacf812f7d62c
# The final runtime is projected onto the matching CUDA base after NVIDIA's
# official composer selects the TensorRT backend and Triton binaries.
MEDDEID_CUDA_BASE_IMAGE=nvidia/cuda:13.3.1-base-ubuntu24.04@sha256:22dc6de51e33966f735440e9601a3006c38a8e6da4b4896b8ebc826e41252ae1
MEDDEID_TENSORRT_BUILDER_IMAGE=nvcr.io/nvidia/tensorrt:26.07-py3@sha256:715352ed6840166888d79b135dd2a8d3f23ffe3169b8cacb6ca4df270388a8df

MEDDEID_MODEL_ID=stighellemans/meddeid-dutch-synth
MEDDEID_MODEL_REVISION=1f20655454dcbd042647cacdfff6b6802a970959
MEDDEID_BUNDLE_SHA256=001123dbc1184751e4bae3c29633d14a5e041acae0c173773f186127ae3fd944

MEDDEID_TRT_PRECISION=fp16
MEDDEID_TRT_OUTPUT_PRECISION=fp32
MEDDEID_TRT_MIN_BATCH=1
MEDDEID_TRT_OPT_BATCH=16
MEDDEID_TRT_MAX_BATCH=64
MEDDEID_TRT_MIN_SEQUENCE=8
MEDDEID_TRT_OPT_SEQUENCE=256
MEDDEID_TRT_MAX_SEQUENCE=512
# Request-local batches plus four weight-free gateway workers were faster on the
# T4 validation matrix than adding a second queue in Triton. Keep the delay as
# an explicit opt-in tuning value for other validated targets.
MEDDEID_TRITON_THROUGHPUT_DYNAMIC_BATCHING=false
MEDDEID_TRITON_THROUGHPUT_QUEUE_DELAY_US=1000
