# PyTorch/CUDA release line used by the MedDeID CUDA image.
# Keep the package version, CUDA wheel channel, and reported CUDA version in sync.
MEDDEID_PYTORCH_VERSION=2.13.0
MEDDEID_PYTORCH_CUDA_VERSION=12.9
MEDDEID_PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu129
MEDDEID_PYTORCH_PLATFORM=linux/amd64
